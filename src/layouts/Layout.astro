---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description = 'Remove background from images instantly with AI. 100% automatic, high quality cutout with transparent background for e-commerce, creators, and designers.',
  activePath = '/',
  faqSchema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://thebgremove.com');

// Structured Data Schema for Web Application
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'thebgremove.com',
  url: 'https://thebgremove.com',
  description: description,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const jsonLdFaq = faqSchema ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    {jsonLdFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />}
  </head>
  <body class="min-h-screen flex flex-col bg-background text-body antialiased selection:bg-primary/10 selection:text-primary">
    <Navbar activePath={activePath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
