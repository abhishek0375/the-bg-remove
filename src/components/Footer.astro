---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-secondary border-t border-border mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 pb-12 border-b border-border">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-2.5 text-heading font-bold text-lg tracking-tight" aria-label="thebgremove.com Homepage">
          <div class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-white">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM7 7a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
          </div>
          <span class="text-lg font-bold text-heading">
            thebgremove<span class="text-primary">.com</span>
          </span>
        </a>
        <p class="text-sm text-body leading-relaxed">
          High-precision AI background removal for e-commerce, creators, photographers, and modern design teams.
        </p>
      </div>

      <!-- Navigation Column: Product -->
      <div>
        <h4 class="text-xs font-semibold text-heading uppercase tracking-wider mb-4">Product</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/remove-background" class="text-body hover:text-primary transition-colors">Background Remover</a></li>
          <li><a href="/#how-it-works" class="text-body hover:text-primary transition-colors">How It Works</a></li>
          <li><a href="/#benefits" class="text-body hover:text-primary transition-colors">Key Benefits</a></li>
          <li><a href="/#use-cases" class="text-body hover:text-primary transition-colors">Use Cases</a></li>
        </ul>
      </div>

      <!-- Navigation Column: Solutions -->
      <div>
        <h4 class="text-xs font-semibold text-heading uppercase tracking-wider mb-4">Solutions</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/#use-cases" class="text-body hover:text-primary transition-colors">E-Commerce Products</a></li>
          <li><a href="/#use-cases" class="text-body hover:text-primary transition-colors">Social Media Creators</a></li>
          <li><a href="/#use-cases" class="text-body hover:text-primary transition-colors">Graphic Designers</a></li>
          <li><a href="/#faq" class="text-body hover:text-primary transition-colors">FAQ & Guides</a></li>
        </ul>
      </div>

      <!-- Navigation Column: Trust & Legal -->
      <div>
        <h4 class="text-xs font-semibold text-heading uppercase tracking-wider mb-4">Trust & Privacy</h4>
        <div class="p-3.5 bg-white rounded-lg border border-border text-xs text-body space-y-2 shadow-subtle">
          <div class="flex items-center gap-1.5 text-success font-medium">
            <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Strict Data Protection</span>
          </div>
          <p class="leading-normal">
            Images are processed securely and never stored, logged, or used for AI model training.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom copyright & secondary note -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-body">
      <p>© {currentYear} thebgremove.com. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#privacy" class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href="#terms" class="hover:text-primary transition-colors">Terms of Service</a>
        <a href="#security" class="hover:text-primary transition-colors">Security</a>
      </div>
    </div>
  </div>
</footer>
