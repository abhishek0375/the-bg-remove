---
interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { name: 'Remove Background', href: '/remove-background' },
  { name: 'How It Works', href: '/#how-it-works' },
  { name: 'Use Cases', href: '/#use-cases' },
  { name: 'FAQ', href: '/#faq' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-sm border-b border-border transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 text-heading font-bold text-lg tracking-tight focus:outline-none" aria-label="thebgremove.com Homepage">
        <div class="w-9 h-9 rounded-md bg-primary flex items-center justify-center text-white shadow-subtle">
          <!-- Clean scissors / cutout icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM7 7a3 3 0 100-6 3 3 0 000 6z" />
          </svg>
        </div>
        <span class="text-xl font-bold tracking-tight text-heading">
          thebgremove
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors hover:text-primary ${
              activePath === link.href ? 'text-primary font-semibold' : 'text-body'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Primary CTA Action -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="/remove-background"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-primary hover:bg-primary-hover rounded-md shadow-subtle transition-all duration-150 active:scale-[0.98]"
        >
          Remove Background
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 text-body hover:text-heading hover:bg-surface-secondary rounded-md border border-border focus:outline-none focus:ring-2 focus:ring-primary"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <!-- Hamburger icon -->
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon -->
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Collapsible Menu Container -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-border bg-white px-4 pt-3 pb-6 space-y-3">
    <nav class="flex flex-col space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-3 py-2 text-base font-medium rounded-md hover:bg-surface-secondary hover:text-primary transition-colors ${
            activePath === link.href ? 'text-primary bg-primary-light font-semibold' : 'text-body'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>
    <div class="pt-2">
      <a
        href="/remove-background"
        class="w-full inline-flex items-center justify-center px-4 py-3 text-base font-semibold text-white bg-primary hover:bg-primary-hover rounded-md shadow-subtle text-center transition-colors"
      >
        Remove Background
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile navigation toggle interaction
  const toggleButton = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleButton && mobileMenu && hamburgerIcon && closeIcon) {
    toggleButton.addEventListener('click', () => {
      const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close mobile menu on link click
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleButton.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
