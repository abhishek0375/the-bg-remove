---
interface Props {
  originalSrc?: string;
  removedSrc?: string;
  alt?: string;
}

const {
  originalSrc = '/demo-original.jpg',
  removedSrc = '/demo-removed.jpg',
  alt = 'Before and after background removal preview',
} = Astro.props;
---

<div class="relative w-full max-w-2xl mx-auto rounded-xl border border-border overflow-hidden select-none bg-white shadow-card">
  <!-- Container for the interactive comparison slider -->
  <div class="relative w-full aspect-[4/3] sm:aspect-[16/10] overflow-hidden" id="comparison-container">

    <!-- AFTER layer: Cutout image on a CSS checkerboard (simulates transparency) -->
    <div
      class="absolute inset-0 w-full h-full"
      style="background-color: #fff; background-image: linear-gradient(45deg, #d1d5db 25%, transparent 25%), linear-gradient(-45deg, #d1d5db 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #d1d5db 75%), linear-gradient(-45deg, transparent 75%, #d1d5db 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;"
    >
      <img
        src={removedSrc}
        alt="After AI background removal — transparent cutout with hair detail preserved"
        class="w-full h-full object-cover"
      />
      <!-- AFTER Badge -->
      <div class="absolute top-4 right-4 bg-heading/85 text-white text-xs font-semibold px-2.5 py-1 rounded shadow-subtle backdrop-blur-sm">
        Background Removed
      </div>
    </div>

    <!-- BEFORE layer: Original photo clipped by the slider position -->
    <div
      class="absolute inset-0 w-full h-full overflow-hidden transition-[clip-path] duration-75"
      id="original-layer"
      style="clip-path: inset(0 50% 0 0);"
    >
      <img
        src={originalSrc}
        alt="Original portrait photo before background removal"
        class="w-full h-full object-cover"
      />
      <!-- BEFORE Badge -->
      <div class="absolute top-4 left-4 bg-heading/85 text-white text-xs font-semibold px-2.5 py-1 rounded shadow-subtle backdrop-blur-sm">
        Original Photo
      </div>
    </div>

    <!-- Dividing line and draggable handle -->
    <div
      class="absolute top-0 bottom-0 w-0.5 bg-white shadow-[0_0_8px_rgba(0,0,0,0.4)] pointer-events-none"
      id="slider-divider"
      style="left: 50%;"
    >
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center shadow-elevated border-2 border-white">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4" transform="rotate(90 12 12)" />
        </svg>
      </div>
    </div>

    <!-- Range slider input overlay for smooth touch and mouse interaction -->
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      id="comparison-range"
      class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-20"
      aria-label="Drag slider to compare original photo against transparent cutout"
    />
  </div>

  <!-- Bottom Helper Bar -->
  <div class="px-4 py-3 bg-surface-secondary border-t border-border flex items-center justify-between text-xs text-body">
    <span class="flex items-center gap-1.5 font-medium text-heading">
      <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      High-precision edge detection on hair & fine details
    </span>
    <span class="hidden sm:inline-block text-body">Drag slider to compare</span>
  </div>
</div>

<script>
  // Interactive slider logic for side-by-side comparison
  const rangeInput = document.getElementById('comparison-range') as HTMLInputElement | null;
  const originalLayer = document.getElementById('original-layer');
  const sliderDivider = document.getElementById('slider-divider');

  if (rangeInput && originalLayer && sliderDivider) {
    const updatePosition = () => {
      const value = rangeInput.value;
      // Invert percentage: clip the BEFORE layer from the right as slider moves right
      const rightInset = 100 - Number(value);
      originalLayer.style.clipPath = `inset(0 ${rightInset}% 0 0)`;
      sliderDivider.style.left = `${value}%`;
    };

    rangeInput.addEventListener('input', updatePosition);
  }
</script>
