---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';

const faqs = [
  {
    question: 'How does thebgremove.com remove image backgrounds?',
    answer: 'Our AI model detects the foreground subject (people, products, animals, or objects) and precisely separates it from the background pixels, delivering a clean transparent PNG cutout in seconds.',
  },
  {
    question: 'Is thebgremove.com completely free to use?',
    answer: 'Yes, you can upload and remove backgrounds from images for free with full resolution previews and instant downloads.',
  },
  {
    question: 'What image file formats and resolutions are supported?',
    answer: 'We support PNG, JPG, JPEG, and WEBP images up to 20MB in file size and resolutions up to 4K.',
  },
  {
    question: 'Are my uploaded images stored or used for AI training?',
    answer: 'No. Your privacy is strictly protected. Uploaded images are processed securely in temporary memory and are never saved, shared, or used to train artificial intelligence models.',
  },
  {
    question: 'Can I use the cutout images for commercial projects?',
    answer: 'Yes. All downloaded images created from your original assets can be used for commercial e-commerce, advertising, and personal projects.',
  },
];

const benefits = [
  {
    icon: '⚡',
    title: 'Lightning Fast Processing',
    description: 'Get high-resolution cutouts in under 3 seconds without tedious manual lasso or pen tool editing.',
  },
  {
    icon: '🔒',
    title: '100% Private & Secure',
    description: 'Files are processed in ephemeral memory and discarded immediately. No image data is ever logged or sold.',
  },
  {
    icon: '🎯',
    title: 'Pixel-Level AI Precision',
    description: 'Handles tricky edges with ease, including flying hair, pet fur, intricate jewelry, and translucent glass.',
  },
  {
    icon: '💼',
    title: 'Full Resolution Quality',
    description: 'Download crisp, high-definition PNGs retaining original dimensions without compression artifacts.',
  },
];

const steps = [
  {
    step: '01',
    title: 'Upload your image',
    description: 'Drag & drop or browse any PNG, JPG, or WEBP photo from your device.',
  },
  {
    step: '02',
    title: 'AI isolates the subject',
    description: 'Our automated vision model detects foreground contours and eliminates the background in seconds.',
  },
  {
    step: '03',
    title: 'Download transparent cutout',
    description: 'Preview the result against a checkerboard backdrop and save your clean PNG image instantly.',
  },
];

const useCases = [
  {
    tag: 'E-Commerce',
    title: 'Product Photos & Listings',
    description: 'Create compliant, distraction-free product listings for Amazon, Shopify, eBay, and Etsy in seconds.',
    metric: '10x Faster Listing Creation',
  },
  {
    tag: 'Creators',
    title: 'Thumbnails & Social Graphics',
    description: 'Isolate portraits and objects to compose viral YouTube thumbnails, Instagram reels, and avatar stickers.',
    metric: 'Zero Manual Masking',
  },
  {
    tag: 'Designers',
    title: 'Marketing & Ad Campaigns',
    description: 'Speed up mockup workflows, display ads, banners, and presentation decks with transparent assets.',
    metric: 'Production-Ready PNGs',
  },
  {
    tag: 'General',
    title: 'Headshots & Pet Photos',
    description: 'Clean up personal profile photos, resume headshots, and pet memories with clean background removal.',
    metric: 'Instant One-Click Cutout',
  },
];
---

<Layout
  title="Remove Background from Image — Free & AI-Powered | thebgremove.com"
  description="Remove background from any image in seconds with AI. 100% automatic cutout, high-resolution transparent PNG output, and zero manual masking."
  faqSchema={faqs}
  activePath="/"
>
  <!-- HERO SECTION -->
  <section class="relative bg-white pt-12 pb-16 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-28 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Trust badge pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-secondary border border-border text-xs font-medium text-heading shadow-subtle">
          <span class="w-2 h-2 rounded-full bg-success"></span>
          <span>Free AI Background Remover • No sign-up required</span>
        </div>

        <!-- H1 Tool Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-heading tracking-tight leading-[1.15]">
          Remove Background from Image — <span class="text-primary">Free & AI-Powered</span>
        </h1>

        <!-- Subtext -->
        <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed">
          Instantly isolate subjects, eliminate unwanted backdrops, and download high-resolution transparent PNGs in seconds.
        </p>

        <!-- Inline Mini-Upload / Primary CTA Container -->
        <div class="pt-4 max-w-xl mx-auto">
          <div class="p-6 sm:p-8 bg-surface-secondary rounded-xl border-2 border-dashed border-border hover:border-primary/60 transition-colors shadow-subtle text-center">
            
            <div class="w-12 h-12 rounded-lg bg-primary-light text-primary mx-auto flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>

            <h2 class="text-lg font-semibold text-heading mb-1">
              Upload an image to remove background
            </h2>
            <p class="text-xs text-body mb-6">
              Drag and drop an image file here, or click to browse (PNG, JPG, WEBP up to 20MB)
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a
                href="/remove-background"
                class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-primary hover:bg-primary-hover rounded-md shadow-card transition-all duration-150 active:scale-[0.98]"
              >
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM7 7a3 3 0 100-6 3 3 0 000 6z" />
                </svg>
                Remove Background
              </a>
            </div>

            <!-- Future batch processing note (unbuilt placeholder) -->
            <!-- Placeholder: Batch background removal queue for e-commerce multi-image upload -->
          </div>

          <div class="mt-4 flex items-center justify-center gap-6 text-xs text-body">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              100% Automatic
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              High Definition
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              No Watermark
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER INTERACTIVE SHOWCASE SECTION -->
  <section class="py-16 sm:py-20 lg:py-24 bg-surface-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight">
          Precision Cutouts for Any Foreground Subject
        </h2>
        <p class="mt-3 text-sm sm:text-base text-body">
          See the difference with intelligent boundary recognition that captures complex strands, soft edges, and fine contours.
        </p>
      </div>

      <!-- Before / After Slider Component -->
      <BeforeAfterSlider />
    </div>
  </section>

  <!-- BENEFITS SECTION (3-4 Cards) -->
  <section id="benefits" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight">
          Engineered for Speed, Precision & Trust
        </h2>
        <p class="mt-3 text-sm sm:text-base text-body">
          Built for professionals who need clean cutouts without compromise.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((benefit) => (
          <div class="p-6 bg-surface-secondary rounded-xl border border-border shadow-subtle hover:shadow-card transition-all duration-200 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-lg bg-white border border-border flex items-center justify-center text-xl mb-4 shadow-subtle">
                {benefit.icon}
              </div>
              <h3 class="text-base font-semibold text-heading mb-2">
                {benefit.title}
              </h3>
              <p class="text-sm text-body leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS SECTION (3 Steps) -->
  <section id="how-it-works" class="py-16 sm:py-20 lg:py-24 bg-surface-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight">
          How It Works in 3 Simple Steps
        </h2>
        <p class="mt-3 text-sm sm:text-base text-body">
          Get a professional cutout in seconds without any complex photo editing tools.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        {steps.map((item, index) => (
          <div class="relative p-6 sm:p-8 bg-white rounded-xl border border-border shadow-subtle flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-bold text-primary">{item.step}</span>
              <span class="w-8 h-8 rounded-full bg-primary-light text-primary flex items-center justify-center text-xs font-bold">
                Step {index + 1}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-heading mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-body leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/remove-background"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-primary hover:bg-primary-hover rounded-md shadow-subtle transition-colors"
        >
          Remove Background Now
        </a>
      </div>
    </div>
  </section>

  <!-- USE CASES SECTION -->
  <section id="use-cases" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight">
          Tailored for Every Workflow
        </h2>
        <p class="mt-3 text-sm sm:text-base text-body">
          From e-commerce stores to personal creative projects, achieve studio-grade isolation instantly.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {useCases.map((useCase) => (
          <div class="p-6 bg-surface-secondary rounded-xl border border-border flex flex-col justify-between hover:border-border-dark transition-colors">
            <div>
              <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded bg-white text-heading border border-border mb-4">
                {useCase.tag}
              </span>
              <h3 class="text-base font-semibold text-heading mb-2">
                {useCase.title}
              </h3>
              <p class="text-sm text-body leading-relaxed mb-6">
                {useCase.description}
              </p>
            </div>
            <div class="pt-4 border-t border-border flex items-center justify-between text-xs font-medium text-primary">
              <span>{useCase.metric}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        ))}
      </div>

      <!-- Future feature comment placeholders -->
      <!-- Placeholder: E-commerce 1-click white-bg preset for marketplace compliance -->
      <!-- Placeholder: 1:1 Square crop preset for Instagram and Shopify catalog cards -->
    </div>
  </section>

  <!-- PRIVACY EXPLANATION SECTION -->
  <section id="privacy" class="py-16 sm:py-20 bg-surface-secondary border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-10 bg-white rounded-xl border border-border shadow-card">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
          <div class="w-14 h-14 rounded-xl bg-success-light text-success flex items-center justify-center shrink-0">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h2 class="text-xl sm:text-2xl font-bold text-heading">
              Your Data & Privacy Are Protected
            </h2>
            <p class="text-sm text-body leading-relaxed">
              We know how important asset confidentiality is. When you remove a background on thebgremove.com, your files are processed in ephemeral memory and purged immediately after download. We never store, display publicly, or train models on user images.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Accordion with semantic <details>/<summary>) -->
  <section id="faq" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-border">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="mt-3 text-sm sm:text-base text-body">
          Everything you need to know about our AI background remover.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-surface-secondary rounded-lg border border-border p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-heading text-base select-none">
              <span>{faq.question}</span>
              <span class="ml-4 shrink-0 transition duration-200 group-open:-rotate-180 text-body group-open:text-primary">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3 text-sm text-body leading-relaxed pt-2 border-t border-border/60">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION -->
  <section class="py-16 sm:py-20 lg:py-24 bg-surface-secondary text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-bold text-heading tracking-tight">
        Ready to Remove Backgrounds from Your Photos?
      </h2>
      <p class="text-base sm:text-lg text-body max-w-xl mx-auto">
        Join creators and merchants who save hours every week with automated AI background removal.
      </p>
      <div class="pt-2">
        <a
          href="/remove-background"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-hover rounded-md shadow-card transition-all duration-150 active:scale-[0.98]"
        >
          Remove Background
        </a>
      </div>
    </div>
  </section>
</Layout>
